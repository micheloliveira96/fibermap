generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model User {
  id String @id
  name String
  email String @unique
  emailVerified Boolean @default(false)
  image String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lastLoginAt DateTime?
  sessions Session[]
  accounts Account[]
  memberships Membership[]
  platformAdministrator PlatformAdministrator?
}
model Session {
  id String @id
  expiresAt DateTime
  token String @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}
model Account {
  id String @id
  accountId String
  providerId String
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken String?
  refreshToken String?
  idToken String?
  accessTokenExpiresAt DateTime?
  refreshTokenExpiresAt DateTime?
  scope String?
  password String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId])
}
model Verification {
  id String @id
  identifier String
  value String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([identifier])
}
model Organization {
  id String @id @default(cuid())
  name String
  profile Json @default("{}")
  status String @default("ACTIVE")
  createdAt DateTime @default(now())
  license License?
  invitations UserInvitation[]
  memberships Membership[]
  assets Asset[]
  terminals OpticalTerminal[]
  connections NetworkConnection[]
  audits AuditLog[]
  internalLinks InternalLink[]
  projects NetworkProject[]
  layers MapLayer[]
  imports ImportBatch[]
  segments CableSegment[]
}
enum Role {
  OWNER
  OPERATOR
  ADMIN
  ENGINEER
  TECHNICIAN
  VIEWER
}
model Membership {
  id String @id @default(cuid())
  userId String
  organizationId String
  role Role @default(VIEWER)
  active Boolean @default(true)
  customPermissions Boolean @default(false)
  permissions String[] @default([])
  delegable String[] @default([])
  parentId String?
  parent Membership? @relation("Delegation", fields: [parentId, organizationId], references: [id, organizationId], onDelete: Restrict)
  children Membership[] @relation("Delegation")
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  @@unique([userId, organizationId])
  @@unique([id, organizationId])
}

model PlatformAdministrator {
  userId String @id
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
}
model SubscriptionPlan {
  id String @id @default(cuid())
  name String
  description String @default("")
  priceCents Int @default(0)
  currency String @default("BRL")
  period String @default("MONTHLY")
  maxUsers Int
  maxProjects Int
  maxStorageBytes BigInt
  features String[] @default([])
  active Boolean @default(true)
  createdAt DateTime @default(now())
  licenses License[]
}
model License {
  organizationId String @id
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  planId String?
  plan SubscriptionPlan? @relation(fields: [planId], references: [id], onDelete: Restrict)
  status String @default("ACTIVE")
  expiresAt DateTime?
  maxUsers Int @default(100)
  maxProjects Int @default(100)
  maxStorageBytes BigInt @default(1073741824)
  features String[] @default([])
  expiryPolicy String @default("READ_ONLY")
  billingStatus String @default("MANUAL")
  updatedAt DateTime @updatedAt
}
model UserInvitation {
  id String @id @default(cuid())
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  email String
  name String
  role Role
  permissions String[] @default([])
  delegable String[] @default([])
  creatorId String
  tokenHash String @unique
  purpose String @default("INVITE")
  expiresAt DateTime
  acceptedAt DateTime?
  revokedAt DateTime?
  createdAt DateTime @default(now())
  @@index([organizationId, email])
}
model AdministrativeAudit {
  id String @id @default(cuid())
  organizationId String?
  actorId String
  action String
  entityId String
  detail Json @default("{}")
  result String @default("SUCCESS")
  createdAt DateTime @default(now())
  @@index([organizationId, createdAt])
}
model PlatformSettings {
  id String @id @default("global")
  name String @default("FiberMap")
  supportEmail String @default("")
  updatedAt DateTime @updatedAt
}
enum AssetKind {
  POP
  OLT
  DIO
  BACKBONE
  DISTRIBUTION
  DERIVATION
  DROP
  CLOSURE
  CTO
  SPLITTER
  CUSTOMER
  POLE
  DUCT
  RESERVE
  COVERAGE
  WAYPOINT
  IMPORTED
}
enum Status {
  PLANNED
  INSTALLED
  MAINTENANCE
  DISABLED
}
model Asset {
  id String @id @default(cuid())
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  code String
  name String
  kind AssetKind
  status Status @default(PLANNED)
  geometry Json
  spatial Unsupported("geometry(Geometry,4326)")?
  metadata Json @default("{}")
  projectId String?
  layerId String?
  importBatchId String?
  project NetworkProject? @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Restrict)
  layer MapLayer? @relation(fields: [layerId, organizationId], references: [id, organizationId], onDelete: Restrict)
  importBatch ImportBatch? @relation(fields: [importBatchId, organizationId], references: [id, organizationId], onDelete: Restrict)
  color String @default("#18a99b")
  geographicLengthM Float @default(0)
  physicalLengthM Float?
  reserveM Float @default(0)
  manufacturer String?
  originLabel String?
  destinationLabel String?
  notes String?
  installedAt DateTime?
  parentId String?
  parent Asset? @relation("AssetContainer", fields: [parentId, organizationId], references: [id, organizationId], onDelete: Restrict)
  children Asset[] @relation("AssetContainer")
  locatedConnections NetworkConnection[]
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  fibers FiberStrand[]
  terminals OpticalTerminal[]
  internalLinks InternalLink[]
  segments CableSegment[]
  @@unique([organizationId, code])
  @@unique([id, organizationId])
  @@index([organizationId, kind, status])
  @@index([organizationId, projectId, layerId])
  @@index([parentId, organizationId])
}
model NetworkProject {
  id String @id @default(cuid())
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name String
  colorPattern Json @default("[\"Azul\",\"Laranja\",\"Verde\",\"Marrom\",\"Cinza\",\"Branco\",\"Vermelho\",\"Preto\",\"Amarelo\",\"Violeta\",\"Rosa\",\"Turquesa\"]")
  createdAt DateTime @default(now())
  assets Asset[]
  layers MapLayer[]
  imports ImportBatch[]
  @@unique([id, organizationId])
  @@unique([organizationId, name])
}
model MapLayer {
  id String @id @default(cuid())
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  projectId String?
  project NetworkProject? @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Restrict)
  name String
  color String @default("#18a99b")
  visible Boolean @default(true)
  version Int @default(1)
  assets Asset[]
  @@unique([id, organizationId])
  @@index([organizationId, projectId])
}
model ImportBatch {
  id String @id @default(cuid())
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  projectId String
  project NetworkProject @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Restrict)
  filename String
  digest String
  source Bytes
  createdAt DateTime @default(now())
  assets Asset[]
  @@unique([id, organizationId])
  @@unique([organizationId, digest])
}
model CableSegment {
  id String @id @default(cuid())
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  assetId String
  asset Asset @relation(fields: [assetId, organizationId], references: [id, organizationId], onDelete: Restrict)
  position Int
  geometry Json
  spatial Unsupported("geometry(LineString,4326)")?
  lengthM Float
  @@unique([assetId, position])
  @@index([organizationId])
}
enum FiberStatus {
  AVAILABLE
  RESERVED
  DAMAGED
  BLOCKED
}
model FiberStrand {
  id String @id @default(cuid())
  assetId String
  asset Asset @relation(fields: [assetId], references: [id], onDelete: Restrict)
  number Int
  tube Int
  color String
  tubeColor String
  status FiberStatus @default(AVAILABLE)
  terminals OpticalTerminal[]
  @@unique([assetId, number])
  @@unique([id, assetId])
}
enum TerminalKind {
  FIBER_A
  FIBER_B
  PON
  DIO
  CTO
  SPLITTER_IN
  SPLITTER_OUT
  CUSTOMER
}
model OpticalTerminal {
  id String @id @default(cuid())
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  assetId String
  asset Asset @relation(fields: [assetId, organizationId], references: [id, organizationId], onDelete: Restrict)
  fiberId String?
  fiber FiberStrand? @relation(fields: [fiberId, assetId], references: [id, assetId], onDelete: Restrict)
  label String
  kind TerminalKind
  links ConnectionTerminal[]
  internalA InternalLink[] @relation("InternalA")
  internalB InternalLink[] @relation("InternalB")
  @@unique([assetId, label])
  @@unique([id, organizationId])
}
model InternalLink {
  id String @id @default(cuid())
  organizationId String
  assetId String
  aId String @unique
  bId String @unique
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  asset Asset @relation(fields: [assetId, organizationId], references: [id, organizationId], onDelete: Restrict)
  a OpticalTerminal @relation("InternalA", fields: [aId, organizationId], references: [id, organizationId], onDelete: Restrict)
  b OpticalTerminal @relation("InternalB", fields: [bId, organizationId], references: [id, organizationId], onDelete: Restrict)
}
enum ConnectionKind {
  SPLICE
  PASS_THROUGH
  PATCH
  DOCUMENTARY
}
model NetworkConnection {
  id String @id @default(cuid())
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  kind ConnectionKind
  locationId String?
  location Asset? @relation(fields: [locationId, organizationId], references: [id, organizationId], onDelete: Restrict)
  tray String?
  lossDb Float @default(0)
  createdAt DateTime @default(now())
  terminals ConnectionTerminal[]
  @@unique([id, organizationId])
  @@index([locationId, organizationId])
}
model ConnectionTerminal {
  terminalId String @id
  organizationId String
  connectionId String
  terminal OpticalTerminal @relation(fields: [terminalId, organizationId], references: [id, organizationId], onDelete: Restrict)
  connection NetworkConnection @relation(fields: [connectionId, organizationId], references: [id, organizationId], onDelete: Restrict)
}
model AuditLog {
  id String @id @default(cuid())
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actorId String
  action String
  entityId String
  detail Json
  createdAt DateTime @default(now())
  @@index([organizationId, createdAt])
}
