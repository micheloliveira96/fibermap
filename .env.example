DATABASE_URL="postgresql://fibermap:fibermap_local@localhost:5432/fibermap"
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"
BETTER_AUTH_URL="http://localhost:3000"
# Vazio usa OpenFreeMap (ruas); não inclua segredos privados.
NEXT_PUBLIC_MAP_STYLE_URL=""
# Opcional: substitui o satélite gratuito EOX 2016 por estilo licenciado do operador.
NEXT_PUBLIC_SATELLITE_STYLE_URL=""
# Mapbox: use /api/maps/satellite acima e um token público pk. abaixo.
# Restrinja as URLs autorizadas no painel Mapbox. Nunca use token sk.
MAPBOX_PUBLIC_TOKEN=""
# Busca explícita de endereços. Photon público é o padrão, sem garantia de SLA.
GEOCODER_URL="https://photon.komoot.io/api/"
# Convites usam links privados se o envio real de e-mail não estiver configurado.
RESEND_API_KEY=""
EMAIL_FROM=""
# Somente no comando de bootstrap, com conexão administrativa; nunca NEXT_PUBLIC_.
PLATFORM_ADMIN_EMAIL=""
PLATFORM_ADMIN_NAME=""
# Configuração inicial opcional: hash SHA-256 de token aleatório de uso único.
FIBERMAP_SETUP_TOKEN_HASH=""
FIBERMAP_SETUP_EXPIRES_AT=""
